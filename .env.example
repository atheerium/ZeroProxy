# =============================================================================
# ZeroProxy Environment Configuration
# =============================================================================
# Copy this file to .env in the project root or export the variables before
# starting zeroproxy. Variables with a default can be left commented out.
#
#   cp .env.example .env
#   zeroproxy
#
# Most operators only set JWT_SECRET and INITIAL_PASSWORD and leave the rest
# at defaults. See the README "Configuration" section for details.
# =============================================================================

# --- Server ---
PORT=4623
HOST=127.0.0.1
# DATA_DIR=~/.zeroproxy
# HOSTNAME=127.0.0.1         # Bind host (alias: HOST). 0.0.0.0 to expose on LAN
# BASE_URL=http://localhost:4623
# CLOUD_URL=                  # Cloud-sync endpoint. Leave unset to disable.

# --- Authentication ---
JWT_SECRET=zeroproxy-default-secret-change-me
# Leave INITIAL_PASSWORD unset to use a random generated password (printed
# once in the startup banner). If set, this is the dashboard password when no
# stored hash exists yet.
# INITIAL_PASSWORD=change-me
# CIPHERROUTE_ENCRYPTION_KEY=   # 64 hex chars (32 bytes) for DB field encryption.
                              # Credentials are encrypted with AES-256-GCM (authenticated)
                              # using an Argon2id-derived key. Legacy AES-CBC (opxenc1)
                              # values stay readable and migrate on next write.
# CIPHERROUTE_ARGON2_M_COST_KB=65536  # Argon2id memory cost in KiB (min 19456)
# CIPHERROUTE_ARGON2_T_COST=3         # Argon2id time cost (min 2)
# CIPHERROUTE_ARGON2_P_COST=1         # Argon2id parallelism
# API_KEY_SECRET=              # HMAC secret for generated API keys. If unset, a
                                # random secret is generated at first startup and
                                # persisted to $DATA_DIR/api_key_secret.
# AUTH_COOKIE_SECURE=false     # Set true behind HTTPS
# SHUTDOWN_SECRET=             # Protect the /api/shutdown endpoint
# NODE_ENV=                    # Set "production" to disable the shutdown endpoint

# --- API Access ---
# REQUIRE_API_KEY=false        # Reject /v1/* requests without Authorization header.
#                              # Configured via dashboard settings, not an env read.

# --- Database (backups) ---
# DATABASE_URL=                # Reserved for future multi-backend support
# DB_BACKUP_MAX_FILES=7
# DB_BACKUP_RETENTION_DAYS=30
# DISABLE_AUTO_BACKUP=false

# --- Streaming Timeouts ---
# STREAM_STALL_TIMEOUT_MS=360000    # Abort stream if no chunk arrives (360 s)
# STREAM_FIRST_CHUNK_TIMEOUT_MS=200000  # Time-to-first-token timeout (200 s)

# --- Observability / Logging ---
# OBSERVABILITY_ENABLED=true        # Reserved for future observability pipeline
# OBSERVABILITY_MAX_JSON_SIZE=5120  # Reserved
# ENABLE_REQUEST_LOGS=false         # Write per-request logs under logs/
# REQUEST_LOG_DIR=logs              # Directory for request log files
# ENABLE_TRANSLATOR=false           # Enable the translator provider
# MACHINE_ID_SALT=endpoint-proxy-salt

# --- OIDC SSO (dashboard login) ---
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=zeroproxy
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:4623/api/auth/oidc/callback

# --- Legacy variable names ---
# The binary has been renamed cipherroute -> openproxy -> zeroproxy, but these
# CIPHERROUTE_* names are still the only ones the code reads for the values
# below, so they are retained deliberately. Do not "fix" them to ZEROPROXY_*:
# the code does not read that prefix for them, and a wrong name here means an
# encrypted database that will not decrypt.
#
# The CLI/profile layer is different: ZEROPROXY_PROFILE, ZEROPROXY_URL,
# ZEROPROXY_API_KEY, ZEROPROXY_DATA_DIR and ZEROPROXY_CONFIG are all read
# natively, and the CIPHERROUTE_* spellings remain accepted for compatibility.

# --- OAuth Endpoint Overrides ---
# Each override lets you redirect a provider's OAuth / API traffic to a
# custom endpoint, e.g. a self-hosted proxy or mirror.

# Claude
# CIPHERROUTE_CLAUDE_AUTHORIZE_URL=
# CIPHERROUTE_CLAUDE_TOKEN_URL=

# Codex (ChatGPT / OpenAI)
# CIPHERROUTE_CODEX_AUTHORIZE_URL=
# CIPHERROUTE_CODEX_TOKEN_URL=

# Gemini / Antigravity
# CIPHERROUTE_GEMINI_TOKEN_URL=
# CIPHERROUTE_GEMINI_USER_INFO_URL=
# CIPHERROUTE_GEMINI_LOAD_CODE_ASSIST_ENDPOINT=
# CIPHERROUTE_ANTIGRAVITY_TOKEN_URL=
# CIPHERROUTE_ANTIGRAVITY_USER_INFO_URL=
# CIPHERROUTE_ANTIGRAVITY_LOAD_CODE_ASSIST_ENDPOINT=
# CIPHERROUTE_ANTIGRAVITY_ONBOARD_USER_ENDPOINT=

# iFlow
# CIPHERROUTE_IFLOW_API_BASE_URL=
# CIPHERROUTE_IFLOW_TOKEN_URL=
# CIPHERROUTE_IFLOW_USER_INFO_URL=

# Kiro
# CIPHERROUTE_KIRO_AUTH_SERVICE_BASE_URL=
# CIPHERROUTE_KIRO_OIDC_BASE_URL=
# CIPHERROUTE_KIRO_TOKEN_URL=

# Other providers
# CIPHERROUTE_OPENAI_TOKEN_URL=
# CIPHERROUTE_CLINE_TOKEN_URL=
# CIPHERROUTE_XAI_TOKEN_URL=
# CIPHERROUTE_VERCEL_API_BASE_URL=
# CIPHERROUTE_DENO_API_BASE_URL=

# --- Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT=

# --- Google Cloud (Vertex AI / Gemini) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- CLI Config Profiles ---
# CIPHERROUTE_PROFILE=work
# CIPHERROUTE_DATA_DIR=
# CIPHERROUTE_URL=
# CIPHERROUTE_API_KEY=
# CIPHERROUTE_CONFIG=

# --- Headroom (proxy pool) ---
# HEADROOM_PYTHON=python3       # Python executable for Headroom proxy pool

# --- HTTP Proxy (outbound) ---
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1
