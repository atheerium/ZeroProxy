#!/usr/bin/env bash
# pre-push: branch name lint + secret scan + stale dashboard warning
set -euo pipefail

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# 1. branch name lint — allow <type>/<kebab> or <agent>/<type>/<kebab>
#    agent prefix is [a-z0-9._-]+, type is feat|fix|...
BRANCH_RE='^([a-z0-9._-]+/)?(feat|fix|docs|chore|refactor|test|build|ci|perf)/[a-z0-9._-]+$'
# also allow pr-* / main / dev for compatibility
ALLOW_RE='^(main|dev|pr-[a-z0-9._-]+)$'
if [[ -n "$BRANCH" ]] && ! echo "$BRANCH" | grep -qE "$BRANCH_RE" && ! echo "$BRANCH" | grep -qE "$ALLOW_RE"; then
  echo "!! pre-push: branch name '$BRANCH' violates convention."
  echo "   Expected: <type>/<kebab>  or  <agent>/<type>/<kebab>"
  echo "   type: feat|fix|docs|chore|refactor|test|build|ci|perf"
  echo "   Examples: feat/kilo-health  or  a1/feat/kilo-health"
  echo "   To bypass (not recommended): git push --no-verify"
  exit 1
fi

# 2. secret scan on outgoing diff vs origin/main or origin/HEAD
#    Each pattern must match a *value*, not a bare identifier. `refresh_token`
#    in particular is also an OAuth 2.0 grant type name that AWS's RegisterClient
#    API takes literally ("grantTypes": ["refresh_token", ...]), so a bare-word
#    match here blocks every correct OIDC implementation. Require an assignment
#    followed by a plausible-length value.
#
#    The refresh_token name is spelled as an explicit case alternation, NOT with
#    `(?i)` or `[Rr]efresh`: this is GNU grep -E, where `(?i:...)` is unsupported
#    (the alternative silently goes inert, disabling the whole check) and
#    `[Rr]efresh_[Tt]oken` still misses the all-caps `REFRESH_TOKEN=` form that a
#    .env file actually uses. Both were tried and both failed the matrix below.
BASE=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD HEAD~1 2>/dev/null || echo "HEAD~1")
DIFF=$(git diff "$BASE"..HEAD -U0 2>/dev/null || true)
SECRET_RE='sk-[a-zA-Z0-9]{20,}|(refresh_token|Refresh_Token|REFRESH_TOKEN)["'"'"']?[[:space:]]*[:=]>?[[:space:]]*["'"'"']?[A-Za-z0-9_.-]{16,}|Bearer[[:space:]]+[A-Za-z0-9_.-]{20,}|BEGIN (RSA|EC) PRIVATE KEY'
if echo "$DIFF" | grep -qE "$SECRET_RE"; then
  echo "!! pre-push: outgoing diff contains potential secret"
  exit 1
fi

# 3. stale dashboard warning
if [[ -d "web/src" && -d "web/dist" ]]; then
  SRC_NEW=$(find web/src -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f1 || echo 0)
  DIST_NEW=$(find web/dist -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f1 || echo 0)
  if awk "BEGIN{exit !($SRC_NEW > $DIST_NEW)}" 2>/dev/null; then
    echo "!! pre-push: web/src newer than web/dist — run: (cd web && pnpm build)"
  fi
fi

# 4. fast astro check (advisory only, keeps push fast — <15s timeout)
if git diff --name-only "$BASE"..HEAD 2>/dev/null | grep -qE '^web/'; then
  if command -v pnpm >/dev/null 2>&1 && [[ -f "web/package.json" ]]; then
    echo "-- pre-push: running fast astro check (advisory, 15s timeout)..."
    if ! timeout 15 pnpm --prefix web exec astro check --minimumSeverity error >/tmp/openproxy-astro-check.log 2>&1; then
      echo "!! pre-push: astro check failed or timed out — see /tmp/openproxy-astro-check.log (advisory, not blocking)"
      tail -20 /tmp/openproxy-astro-check.log 2>/dev/null || true
    else
      echo "   astro check: ok"
    fi
  fi
fi

exit 0
